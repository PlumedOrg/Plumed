# Umami analytics for plumed.fr. Copy to author_scripts/website.env (gitignored):
# deploy.sh sends it to the VPS as ~/docker/plumed_website/.env, which
# website/build.sh passes to the build. Leave ANALYTICS_URL or
# ANALYTICS_WEBSITE_ID empty to build the site without analytics.
# Values without quotes: docker --env-file keeps them as typed.

# URL of the Umami tracker script, e.g. https://u.plumed.fr/getinfo
ANALYTICS_URL=
# Website id given by Umami for plumed.fr
ANALYTICS_WEBSITE_ID=
# true: visitors whose browser sends "Do Not Track" are not counted
ANALYTICS_DNT=true
# Optional: subresource integrity of the script (breaks when Umami updates it):
#   curl -fsSL "$ANALYTICS_URL" | openssl dgst -sha384 -binary | openssl base64 -A
# then prefix the output with sha384-
ANALYTICS_SRI=
