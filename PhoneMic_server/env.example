# Copy to .env (gitignored) next to docker-compose.yml. Every value is optional.

# Rooms open at the same time, beyond that new rooms get 503 (queued audio is
# capped at 1 MiB per inbox and 64 MiB for the whole relay, in RAM)
PLUMED_RELAY_MAX_ROOMS=500

# Rooms open at the same time for one client IP (an IPv6 /64), beyond that
# 429. A hospital behind one NAT address shares it: raise it if needed
PLUMED_RELAY_ROOMS_PER_IP=100

# Room creations per client IP per hour (Plumed opens one per session and a
# new one every 10 min while the QR code is shown without a phone)
PLUMED_RELAY_ROOMS_PER_IP_PER_HOUR=300

# Model relay (plumed-models). Comma-separated owner/name@revision pairs it
# serves; empty or unset: the repositories and pinned revisions the app
# downloads (MODEL_REPOS in protocol/src/models.rs)
PLUMED_MODELS_REPOS=

# File streams at the same time, for everyone and per client IP (an IPv6
# /64); beyond that 503 with Retry-After. The app downloads one file at a time
PLUMED_MODELS_MAX_STREAMS=32
PLUMED_MODELS_STREAMS_PER_IP=8

# Optional Hugging Face token (read access is enough), sent to huggingface.co
# only, never to its CDN. The model repositories are public: leave it empty
# unless the hub rate-limits the server
HF_TOKEN=
