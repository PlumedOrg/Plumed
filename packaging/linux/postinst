#!/bin/sh
# Plumed post-install hook (.deb / .rpm):
#   Rename Plumed.desktop (generated by Tauri) to org.olicorne.plumed.desktop.
#   The /dev/uinput udev rule is not shipped: the app shows the command that
#   installs it when direct typing on Wayland is unavailable.
set -e

SRC=/usr/share/applications/Plumed.desktop
DEST=/usr/share/applications/org.olicorne.plumed.desktop
if [ -f "$SRC" ]; then
    mv -f "$SRC" "$DEST"
fi
update-desktop-database /usr/share/applications/ 2>/dev/null || true

exit 0
