{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "recording-overlay",
    "description": "Capability for the recording overlay: event listening and the few app commands it invokes (see docs/ARCHITECTURE.md)",
    "windows": ["recording_overlay"],
    "permissions": [
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "allow-get-all-settings",
        "allow-cancel-recording",
        "allow-set-overlay-input-region",
        "allow-hide-overlay-if-idle",
        "allow-ack-result-panel-shown",
        "allow-consume-pending-result",
        "allow-copy-result-text"
    ]
}
