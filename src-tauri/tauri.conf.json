{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Plumed",
    "mainBinaryName": "plumed",
    "version": "1.0.0",
    "identifier": "org.olicorne.plumed",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Plumed",
                "width": 940,
                "height": 768,
                "minWidth": 890,
                "minHeight": 720,
                "backgroundColor": "#18181b",
                "theme": "Dark"
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost",
                "object-src": "'none'",
                "base-uri": "'none'",
                "form-action": "'none'",
                "frame-src": "'none'",
                "frame-ancestors": "'none'",
                "worker-src": "'none'"
            },
            "dangerousDisableAssetCspModification": ["style-src"]
        },
        "macOSPrivateApi": true
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Utility",
        "icon": [
            "icons/32x32.png",
            "icons/64x64.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/256x256.png",
            "icons/icon.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "../resources/tokenizer.json",
            "../resources/audio/**/*",
            "../resources/grammalecte/**/*"
        ],
        "macOS": {
            "minimumSystemVersion": "13.4",
            "entitlements": "./Entitlements.plist"
        },
        "linux": {
            "appimage": {
                "files": {
                    "/usr/share/README.md": "../README.md",
                    "/usr/resources/tokenizer.json": "../resources/tokenizer.json",
                    "/usr/resources/audio": "../resources/audio/",
                    "/usr/resources/grammalecte": "../resources/grammalecte/"
                }
            },
            "deb": {
                "recommends": [
                    "wl-clipboard",
                    "libgtk-layer-shell0"
                ],
                "postInstallScript": "../packaging/linux/postinst",
                "preRemoveScript": "../packaging/linux/prerm"
            },
            "rpm": {
                "depends": [
                    "webkit2gtk4.1",
                    "libayatana-appindicator-gtk3",
                    "openssl-libs",
                    "pipewire-pulseaudio",
                    "pipewire-utils",
                    "xdg-desktop-portal"
                ],
                "recommends": [
                    "gtk-layer-shell",
                    "wl-clipboard"
                ],
                "postInstallScript": "../packaging/linux/postinst",
                "compression": {
                    "type": "none"
                }
            }
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    },
    "plugins": {
        "updater": {
            "active": true,
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxRjkyMDA1QjRGOTUwNTAKUldSUVVQbTBCU0Q1d2ZrNzIvYTZ3T2Q3WEt2R3I2WjRxQ3lFWk9XbzNWbmN3RXI0c210R2oweHkK",
            "endpoints": ["https://github.com/PlumedOrg/Plumed/releases/latest/download/latest.json"],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
